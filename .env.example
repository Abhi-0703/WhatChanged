# What Changed? Environment Configuration
# Default backend: ollama (local, privacy-first, fully offline)
# Optional second backend: gemini
WC_BACKEND=ollama
OLLAMA_MODEL=gemma4:e4b
OLLAMA_HOST=http://localhost:11434

# Gemini API backend settings (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it

# Default watcher settings
WC_INTERVAL=5
WC_SENSITIVITY=2.0
WC_MAX_CALLS_PER_MIN=6
WC_IMAGE_MODE=side_by_side
