# What Changed? Environment Configuration
# Default backend: gemini (hosted open-weight Gemma 4 via Google Gemini API)
# Local privacy / offline backend: ollama (on-device open-weight Gemma 4)
WC_BACKEND=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# Local Ollama backend settings (on-device offline option)
OLLAMA_MODEL=gemma4:e2b
OLLAMA_HOST=http://localhost:11434

# Watcher settings
WC_INTERVAL=5.0
WC_SENSITIVITY=2.0
WC_MAX_CALLS_PER_MIN=4
WC_IMAGE_MODE=side_by_side
WC_MAX_SIDE=768
WC_JPEG_QUALITY=85
